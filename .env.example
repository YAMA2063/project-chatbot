# ================================================================
# KONFIGURASI ENVIRONMENT — CHATBOT RAG GUNADARMA v2.0
# ================================================================
# Salin file ini menjadi .env dan isi nilai yang sesuai:
#   copy .env.example .env

# --- LLM API PROVIDERS ---
# Groq API Key (Llama 3.3 70B Versatile)
# Dapatkan gratis di: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Keys (Google AI Studio) — Rotasi Otomatis Failover
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3

# Gemini Model Selection (Cascade Fallback)
# Pilihan: models/gemini-3.5-flash, models/gemini-3.8-flash, models/gemini-3.1-flash-lite
GEMINI_MODEL=models/gemini-3.5-flash

# Provider LLM: auto (Groq -> Gemini rotasi), gemini (Gemini rotasi -> Groq), groq (Groq only)
LLM_PROVIDER=auto

# --- ADMIN CREDENTIALS & SECURITY ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Bcrypt Hash untuk password admin (Generate via migrate_password.py atau endpoint /admin/ganti-password)
ADMIN_PASSWORD_HASH=$2b$12$your_bcrypt_hash_here

# JWT Secret Key (Generate random 32 bytes hex)
JWT_SECRET=your_jwt_secret_random_hex_key_here

# Allowed CORS Origins (Pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- SMTP / EMAIL RECOVERY (OTP) ---
ADMIN_EMAIL=admin@example.com
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
